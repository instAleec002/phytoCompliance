# Valores públicos: todo NEXT_PUBLIC_ queda dentro del paquete del navegador. Nunca poner aquí el token de la API;
# se ingresa en Ajustes y se guarda en el dispositivo.
# URL base de la API; la web en la nube y la aplicación de escritorio apuntan al mismo backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
