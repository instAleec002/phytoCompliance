# Copiar a non_private/non_envs/.env y completar. Nunca versionar el .env real.
POSTGRES_USER=fito
POSTGRES_PASSWORD=
POSTGRES_DB=fito
POSTGRES_PORT=5434
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
