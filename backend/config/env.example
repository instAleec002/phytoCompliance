# API: dirección de la interfaz (para los enlaces de activación) y orígenes de CORS. El acceso es por cuentas de
# usuario (make crear-admin para la primera).
API_WEB_URL=http://localhost:3000
API_CORS_ORIGINS=http://localhost:3000,tauri://localhost,http://tauri.localhost
